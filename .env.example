# Copy this file to `.env.local` (git-ignored) and fill in local values.
# Never commit real credentials, tokens or private keys.

# Log verbosity: debug | info | warn | error
AURALIDE_LOG_LEVEL=info

# Dev only: Vite dev server URL loaded by the Electron main process.
# AURALIDE_DEV_SERVER_URL=http://localhost:5173

# Provider credentials for the future agent layer belong in `.env.local` only.
# ANTHROPIC_API_KEY=
