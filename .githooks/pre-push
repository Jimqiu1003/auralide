#!/bin/sh
# Auralide local Git guard.
#
# Why this exists: a fast local pre-flight. It stopped being the only control on 2026-10-15, when
# the repository was made public and a GitHub ruleset ("main-protection") took over enforcement:
# no force pushes, no deletion, changes only through a pull request, and the `verify` status check
# required. The server refuses a direct push with GH013 even when this hook is bypassed.
#
# It is still a local convenience, NOT a security boundary: hooks are not cloned and can be bypassed
# with `git push --no-verify`. The authoritative rules are in AGENTS.md and
# docs/agents/COLLABORATION.md; the ruleset is the enforced one.
#
# Deliberate override (skips this hook only - the ruleset will still reject a direct push to main):
#   AURALIDE_ALLOW_MAIN_PUSH=1 git push origin main

protected_ref="refs/heads/main"

if [ "${AURALIDE_ALLOW_MAIN_PUSH}" = "1" ]; then
  echo "auralide: AURALIDE_ALLOW_MAIN_PUSH=1 - main protection override accepted"
  exit 0
fi

blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    "$protected_ref")
      echo "auralide: refusing to push to $remote_ref" >&2
      blocked=1
      ;;
  esac
done

if [ "$blocked" = "1" ]; then
  cat >&2 <<'EOF'

main only accepts changes through a Pull Request (see docs/agents/COLLABORATION.md):

    git push -u origin <type>/<topic>
    gh pr create --fill --base main

Override for a deliberate exception: AURALIDE_ALLOW_MAIN_PUSH=1 git push origin main
EOF
  exit 1
fi

exit 0
