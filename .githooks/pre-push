#!/bin/sh
# Auralide local Git guard.
#
# Why this exists: GitHub branch protection and repository rulesets are not available for private
# repositories on the current (Free) plan - both APIs answer HTTP 403 "Upgrade to GitHub Pro".
# Until the plan supports it, this hook is the local control that keeps `main` integration-only.
#
# It is a local convenience, NOT a security boundary: hooks are not cloned, can be bypassed with
# `git push --no-verify`, and do not constrain anyone else. The authoritative rules are in
# AGENTS.md and docs/agents/COLLABORATION.md; CI runs on every pull request regardless.
#
# Deliberate override (for a genuine emergency):
#   AURALIDE_ALLOW_MAIN_PUSH=1 git push origin main

protected_ref="refs/heads/main"

if [ "${AURALIDE_ALLOW_MAIN_PUSH}" = "1" ]; then
  echo "auralide: AURALIDE_ALLOW_MAIN_PUSH=1 - main protection override accepted"
  exit 0
fi

blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    "$protected_ref")
      echo "auralide: refusing to push to $remote_ref" >&2
      blocked=1
      ;;
  esac
done

if [ "$blocked" = "1" ]; then
  cat >&2 <<'EOF'

main only accepts changes through a Pull Request (see docs/agents/COLLABORATION.md):

    git push -u origin <type>/<topic>
    gh pr create --fill --base main

Override for a deliberate exception: AURALIDE_ALLOW_MAIN_PUSH=1 git push origin main
EOF
  exit 1
fi

exit 0
